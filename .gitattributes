# 行尾与编码规则
#
# 为什么要显式声明
#   Windows 仓库 + Linux 目标机的混合场景，git 的 autocrlf 会把
#   shell 脚本转成 CRLF，导致远端 bash 报 $'\r': command not found。
#   而 .bat 必须是 CRLF，否则 cmd 解析异常。

# 默认：由 git 自动判断
* text=auto

# 源码：统一 LF
*.py      text eol=lf
*.sh      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# PowerShell 与批处理：必须 CRLF
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# 二进制：不做任何转换
*.exe     binary
*.dll     binary
*.png     binary
*.jpg     binary
*.zip     binary
*.tar.gz  binary
